---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${basePath}/ja/`;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://yomuvia.com/ja/" />
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    <title>YOMUVIA</title>
  </head>
  <body>
    <a href={target}>YOMUVIA 日本語サイトへ移動</a>
  </body>
</html>
