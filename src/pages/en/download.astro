---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, withBase } from "@/data/site";
---

<BaseLayout title="Download - YOMUVIA" description="Download YOMUVIA 0.6.1 Public Beta for Windows, with requirements, installation steps, and safety information." canonicalPath="/en/download/" lang="en">
  <header class="page-hero"><div class="container"><p class="eyebrow">Windows / 0.6.1 Public Beta</p><h1>Read the video.<br />Right now.</h1><p class="lead">YOMUVIA brings AI subtitles and translation, fast clipping, and video joining into one player. Free stays free, and Pro includes a seven-day trial.</p><div class="hero-actions">{site.downloadUrl ? <a class="button primary" href={site.downloadUrl}>Download for Windows</a> : <a class="button primary" href={site.supportUrl}>Get a release notice</a>}<a class="button secondary" href={withBase("/en/changelog/")}>Read the changelog</a></div></div></header>
  <section class="content-band" id="release-status"><div class="container release-facts"><div><small>Current version</small><strong>{site.version}</strong></div><div><small>Supported OS</small><strong>Windows 10 / 11 x64</strong></div><div><small>Verification</small><strong>208 automated tests and install smoke test pass</strong></div></div></section>
  <section class="content-band alt"><div class="container content-grid"><h2>About the public beta</h2><div class="prose"><p>Installation, launch, bundled FFmpeg, Pro licensing, cloud AI connection, and uninstall have been verified. Auto-update checks a cryptographically signed manifest and SHA-256 before accepting an installer.</p><p>The current installer does not yet have a Windows code-signing certificate, so SmartScreen may display a warning. Download only from this official site or the official GitHub Release.</p></div></div></section>
  <section class="content-band"><div class="container content-grid"><h2>Installation</h2><div class="prose"><ol><li>Use “Download for Windows” to get the installer.</li><li>If SmartScreen appears, verify the source, choose “More info,” then “Run anyway.”</li><li>Choose optional Explorer integration and file associations.</li><li>Run later installers as in-place updates. Favorites, subtitles, and settings stay in the user data directory.</li></ol><p><a href={withBase("/en/system-requirements/")}>Review system requirements</a></p></div></div></section>
</BaseLayout>
