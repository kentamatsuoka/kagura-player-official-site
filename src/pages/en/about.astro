---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, withBase } from "@/data/site";
---

<BaseLayout title="About YOMUVIA - AI subtitles, clipping, and video joining" description="YOMUVIA is a Windows video player that helps you understand videos with AI subtitles, clip moments while watching, and join selected clips into one video." canonicalPath="/en/about/" lang="en" breadcrumbTitle="About YOMUVIA">
  <header class="page-hero"><div class="container"><p class="eyebrow">ABOUT YOMUVIA</p><h1>Turn watching time<br />into making time.</h1><p class="lead">YOMUVIA connects video playback, subtitles, clipping, and joining in one Windows application.</p></div></header>
  <section class="content-band"><div class="container content-grid"><h2>Why it exists</h2><div class="prose"><p>Finding a moment in a video often means opening a separate editor and locating the same position again. Foreign-language videos add another disconnected subtitle workflow.</p><p>YOMUVIA keeps those steps together: understand the scene, mark A and B while watching, save the clip, then arrange selected clips into one video.</p></div></div></section>
  <section class="content-band alt"><div class="container content-grid"><h2>Product principles</h2><div class="prose"><h3>Local first</h3><p>Playback, audio extraction, and Whisper transcription run locally by default. Optional cloud correction and translation do not upload the video file itself.</p><h3>Honest product status</h3><p>Released features, limitations, and future plans are kept separate. Current release facts are available on the download and changelog pages.</p><h3>Fewer workflow breaks</h3><p>Watch, correct subtitles, clip, and join without repeatedly switching tools.</p></div></div></section>
  <section class="content-band"><div class="container content-grid"><h2>Product facts</h2><div class="prose"><ul><li>Product: YOMUVIA</li><li>Platform: Windows 10 / 11 x64</li><li>Current version: {site.version}</li><li>Free: ¥0</li><li>Pro: ¥1,480/month or ¥14,800/year</li></ul><div class="hero-actions"><a class="button primary" href={withBase("/en/download/")}>Download for Windows</a><a class="button secondary" href={withBase("/en/changelog/")}>View changelog</a></div><p><a class="text-link" href={site.supportUrl}>Contact support</a></p></div></div></section>
</BaseLayout>
