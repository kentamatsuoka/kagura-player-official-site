---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/data/site";
---

<BaseLayout title="Purchase complete - YOMUVIA" description="Complete YOMUVIA Pro activation." canonicalPath="/en/purchase/success/" lang="en" noindex>
  <header class="page-hero"><div class="container activation-panel"><p class="eyebrow">YOMUVIA PRO</p><h1>Your seven-day Pro trial<br />has started.</h1><p class="lead">Copy the code, then open Settings → PRO in YOMUVIA and paste it into the purchase-code field.</p><code class="activation-code" data-activation-code>Confirming your purchase...</code><div class="activation-actions"><button class="button primary" type="button" data-copy-activation disabled>Copy activation code</button><a class="button secondary" href={withBase("/en/subscription/")}>Activation steps</a><a class="button secondary" href={withBase("/en/subscription/#cancel")}>How to cancel</a></div><p class="status-callout" data-activation-status>Keep this page open until activation is complete.</p></div></header>
  <section class="content-band"><div class="container content-grid"><h2>Where to paste it</h2><div class="prose"><img class="guide-image" src={withBase("/media/real-app/pro-activation.png")} alt="YOMUVIA Pro activation field" /><p>After activation, the app shows your trial status and the subscription-management button.</p></div></div></section>
  <script>
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get("session_id")?.trim() ?? "";
    const code = document.querySelector<HTMLElement>("[data-activation-code]");
    const copy = document.querySelector<HTMLButtonElement>("[data-copy-activation]");
    const status = document.querySelector<HTMLElement>("[data-activation-status]");
    if (code && copy && status) {
      if (/^cs_(test_)?[A-Za-z0-9_]+$/.test(sessionId)) {
        code.textContent = sessionId;
        copy.disabled = false;
        status.textContent = "Use this activation code only for your own purchase.";
        copy.addEventListener("click", async () => {
          await navigator.clipboard.writeText(sessionId);
          copy.textContent = "Copied";
        });
      } else {
        code.textContent = "Activation code unavailable";
        status.textContent = "Check your purchase email or contact support using the email address from checkout.";
      }
    }
  </script>
</BaseLayout>
